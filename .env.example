# WasteWise AI Environment Variables Configuration
# Copy this file to .env and configure values before starting the application.

# 1. Application Security
# Generate a strong 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Connection
# SQLite fallback default for local dev:
DATABASE_URL=sqlite:///./wastewise.db
# PostgreSQL Production format:
# DATABASE_URL=postgresql://wastewise_user:your_secure_db_password@localhost:5432/wastewise_db

# 3. LLM API Key (Optional: OpenAI or compatible API)
# Leave empty for deterministic grounded fallback engine with zero external API dependencies
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# 4. CORS Origins (Comma-separated trusted domains, NO wildcards with credentials)
# Example: https://wastewise-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 5. Production Environment Flag
ENVIRONMENT=production
# Set to true only in dev/eval environments to seed initial demo data
ENABLE_DEMO_SEED=false
